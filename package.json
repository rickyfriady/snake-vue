{
  "name": "snake-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint . --fix",
    "test": "bun test",
    "release:check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "release:tag": "bash scripts/release-tag.sh",
    "danger:ci": "danger ci",
    "danger:local": "danger local",
    "prepare": "husky",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vueuse/core": "^14.2.1",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.30",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@types/web-bluetooth": "^0.0.21",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/eslint-plugin": "1.3.26",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/tsconfig": "^0.9.0",
    "danger": "^13.0.7",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-formatter-checkstyle": "^8.40.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security-node": "^1.1.4",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "husky": "^9.1.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5"
  }
}
